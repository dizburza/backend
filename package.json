{
  "name": "backend",
  "version": "1.0.0",
  "description": "Blockchain payroll and banking backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "generateSignature": "ts-node tests/generateSignature.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test tests/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/**/*.test.ts",
    "test:setup": "drizzle-kit migrate",
    "db:seed:tax": "tsx src/db/seed-tax.ts",
    "db:tax-authority-wallet": "tsx src/db/set-tax-authority-wallet.ts"
  },
  "keywords": [
    "blockchain",
    "payroll",
    "banking",
    "ethereum"
