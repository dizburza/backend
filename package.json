    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.9",
    "rate-limit-redis": "^6.0.1",
    "viem": "^2.55.13",
    "winston": "^3.18.3"
  },
