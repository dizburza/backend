# Environment
NODE_ENV=
PORT=

# Postgres (primary datastore)
DATABASE_URL=postgresql://user:pass@localhost:5432/dizburza
DATABASE_POOL_MAX=10
# Only for hosted Postgres behind a transaction pooler (Neon's -pooler host,
# Supabase's pgbouncer=true). Migrations run here, the app runs on the pooled
# URL above. Leave blank locally.
DIRECT_DATABASE_URL=

# MongoDB. Only read by `npm run db:port` during the one-off migration.
# Nothing at runtime uses it once the port is done.

# Redis. Optional on a single instance, required once you run more than one: it
# fans realtime events between instances, elects a single indexer leader, and
# holds the rate limit counters, which are otherwise per process.
# e.g. redis://localhost:6379 or rediss://user:pass@host:6379
REDIS_URL=

# Set true wherever more than one process serves the API: several replicas, PM2
# cluster mode, docker compose --scale. Refuses to boot without REDIS_URL,
# because the alternative is three failures that nothing reports.
EXPECT_MULTI_INSTANCE=false

# ERC-2771 gasless writes. Unset means users pay their own gas and POST /relay
# answers 503. The forwarder verifies the user's EIP-712 signature on chain, so
# this key buys gas and cannot act as anyone: a leak wastes money, it does not
# forge authority. Fund it with ETH and alarm on the balance.
RELAYER_PRIVATE_KEY=
# Warn below this. Funds CashLink refunds; 0.02 ETH by default.
SWEEPER_MIN_BALANCE_WEI=5000000000000000

# Send by link. Needs the relayer, since claims and refunds are paid for here.
# Unset and the CashLink routes report themselves disabled.
CASHLINK_ADDRESS=
# Default life of a link. The contract bounds this between 1 hour and 7 days.
CASHLINK_WINDOW_SECONDS=43200
# How long one browser holds a link while its claim is in flight, so a second
# person opening the same link is told rather than left watching a revert.
CASHLINK_CLAIM_LEASE_SECONDS=120
CASHLINK_SWEEP_INTERVAL_MS=300000
# Naira per ETH, used to quote sponsored gas as a cNGN fee. A configured number
# rather than a feed: set it high enough to cover the gas it stands in for.
# ETH/NGN comes from CoinGecko. These only shape or rescue the quote.
ETH_PRICE_NGN_FALLBACK=2500000
COINGECKO_API_KEY=
FX_CACHE_TTL_MS=300000
CASHLINK_FEE_MARGIN_PERCENT=25
CASHLINK_FEE_ROUNDING_NGN=10
CASHLINK_FEE_MIN_NGN=10

# Blockchain
PAYROLL_TOKEN_ADDRESS=
PAYROLL_TOKEN_LOGO_URL=
RPC_URL=
CHAIN_ID=84532
cNGN_ADDRESS=
FACTORY_ADDRESS=0xYourFactoryContractAddress

# Alchemy Webhooks
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Indexer (cursor-based log worker — durable source of truth for history)
INDEXER_ENABLED=true
# Block the cNGN contract was deployed at, so the first backfill isn't scanning
# from genesis. Only used when no cursor exists yet.
INDEXER_START_BLOCK=0
# Blocks to stay behind the chain tip so reorgs settle before persisting.
INDEXER_CONFIRMATIONS=12
# Base Sepolia caps eth_getLogs at 1000 blocks per request.
INDEXER_BLOCK_RANGE=10
INDEXER_POLL_INTERVAL_MS=12000
# Sweep for just-submitted transactions. Faster than the block cursor so a user
# watching their own send sees it confirm without waiting out the reorg lag.
INDEXER_PENDING_INTERVAL_MS=4000
# Receipts add fee/gasUsed at one RPC call per transaction. Set false to make a
# large first backfill cheap.
INDEXER_FETCH_RECEIPTS=true

# Domain shown in the sign-in message and checked when verifying it. Must match
# the domain users actually visit, so a signature harvested elsewhere fails here.
AUTH_DOMAIN=dizburza.app

# Session cookie lifetime. Accepts 24h, 7d, or raw seconds.
# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=

# Allowed CORS origins
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_DEV=

# Rate Limiting
RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX=

# Dev only, used by `npm run generateSignature` to exercise the auth flow by
# hand. Use a throwaway key that never holds real funds.
API_URL=http://localhost:5050
USER_PRIVATE_KEY=
USER_ADDRESS=

# Organization email verification (Resend). Unset and the send route reports
# itself disabled rather than silently discarding the code.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
EMAIL_FROM_ADDRESS=Dizburza <onboarding@dizburza.app>
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5